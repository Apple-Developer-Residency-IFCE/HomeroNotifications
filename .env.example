# Apple Developer key identifier.
APNS_KEY_ID=

# Apple Developer team identifier.
APNS_TEAM_ID=

# Bundle identifier of the Homero iOS application.
APNS_BUNDLE_ID=

# Absolute path to the local .p8 private key. Never commit the key itself.
APNS_PRIVATE_KEY_PATH=

# Use sandbox for local/Xcode builds and production for TestFlight/App Store builds.
APNS_ENVIRONMENT=sandbox
